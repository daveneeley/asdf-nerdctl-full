#!/usr/bin/env bash

set -euo pipefail

current_script_path=${BASH_SOURCE[0]}
plugin_dir=$(dirname "$(dirname "$current_script_path")")

# shellcheck source=../lib/utils.bash
source "${plugin_dir}/lib/utils.bash"

install_path="${ASDF_INSTALL_PATH%/bin}/bin"
systemd_user_dir="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"

rollback() {
  local setuptool="$install_path/containerd-rootless-setuptool.sh"
  local rootlesskit="$install_path/rootlesskit"

  if [ "$(uname -s)" = "Linux" ] &&
    command -v systemctl >/dev/null 2>&1 &&
    systemctl --user show-environment >/dev/null 2>&1; then
    if [ -x "$setuptool" ]; then
      "$setuptool" uninstall-buildkit || :
      "$setuptool" uninstall || :
    fi

    rm -rf \
      "$systemd_user_dir/containerd.service.d" \
      "$systemd_user_dir/buildkit.service.d"
    systemctl --user daemon-reload || :

    if [ -x "$rootlesskit" ]; then
      "$rootlesskit" rm -rf "$HOME/.local/share/containerd" || :
    fi
  fi

  rm -rf "$install_path"
}

install_exit() {
  local status=$?

  trap - EXIT
  if [ "$status" -ne 0 ]; then
    rollback
  fi
  exit "$status"
}

trap install_exit EXIT

install_version "$ASDF_INSTALL_TYPE" "$ASDF_INSTALL_VERSION" "$ASDF_INSTALL_PATH"

if [ "$(uname -s)" = "Linux" ] &&
  command -v systemctl >/dev/null 2>&1 &&
  systemctl --user show-environment >/dev/null 2>&1; then
  apparmor_userns_setting=/proc/sys/kernel/apparmor_restrict_unprivileged_userns
  if [ -r "$apparmor_userns_setting" ] &&
    [ "$(<"$apparmor_userns_setting")" = "1" ]; then
    printf '%s\n' \
      "Skipping rootless containerd and BuildKit setup: /proc/sys/kernel/apparmor_restrict_unprivileged_userns is set to 1." \
      "Set it to 0 before reinstalling to enable rootless services." >&2
  else
    cni_path="$install_path/cni"

    mkdir -p \
      "$systemd_user_dir/containerd.service.d" \
      "$systemd_user_dir/buildkit.service.d"
    printf '[Service]\nEnvironment=CNI_PATH=%s\n' "$cni_path" \
      >"$systemd_user_dir/containerd.service.d/nerdctl-full.conf"
    cat >"$systemd_user_dir/buildkit.service.d/nerdctl-full.conf" <<EOF
[Service]
Environment=CNI_PATH=$cni_path
EOF
    systemctl --user daemon-reload

    export PATH="$install_path:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
    export CNI_PATH="$cni_path"
    systemctl --user set-environment "CNI_PATH=$cni_path"
    "$install_path/containerd-rootless-setuptool.sh" install

    buildkit_install_status=0
    "$install_path/containerd-rootless-setuptool.sh" install-buildkit ||
      buildkit_install_status=$?

    cat >"$systemd_user_dir/buildkit.service.d/nerdctl-full.conf" <<EOF
[Service]
Environment=CNI_PATH=$cni_path
ExecStart=
ExecStart=$install_path/containerd-rootless-setuptool.sh nsenter -- buildkitd --oci-worker=true --oci-worker-rootless=true --containerd-worker=false --oci-worker-net=bridge --oci-cni-binary-dir=$cni_path
EOF
    systemctl --user daemon-reload

    if [ "$buildkit_install_status" -ne 0 ]; then
      systemctl --user restart buildkit.service
    fi
    systemctl --user is-active --quiet buildkit.service
  fi
else
  printf '%s\n' \
    "Skipping rootless containerd and BuildKit setup: Linux user systemd is unavailable." >&2
fi
